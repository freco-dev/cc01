{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=access_server;Username=postgres;Password=root"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "accessserver:"
  },
  "Jwt": {
    "Issuer": "AccessServer.Api",
    "Audience": "AccessServer.Clients",
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  }
}
