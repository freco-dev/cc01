{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "//": [
    "ConnectionStrings:Access va Jwt:SigningKey bu faylda YO'Q — ular sir.",
    "Prod'da environment o'zgaruvchilari yoki sir menejeri orqali beriladi:",
    "  ConnectionStrings__Access=...",
    "  Jwt__SigningKey=...",
    "Ular berilmasa server ishga tushmaydi (ValidateOnStart).",
    "",
    "OAuth sirlari ixtiyoriy — berilmasa o'sha provayder o'chirilgan holda",
    "qoladi va server baribir ishga tushadi:",
    "  OAuth__Github__ClientId=...   OAuth__Github__ClientSecret=...",
    "  OAuth__Google__ClientId=...   OAuth__Google__ClientSecret=...",
    "Callback manzillari provayder panelida ro'yxatdan o'tkaziladi:",
    "  https://<host>/v1/auth/oauth/github/callback",
    "  https://<host>/v1/auth/oauth/google/callback",
    "",
    "Operator API (tarifni o'zgartirish) ixtiyoriy — kalit berilmasa",
    "/internal/v1 umuman ro'yxatga olinmaydi (404):",
    "  Internal__AdminKey=...   (faqat ichki listener'da, X-Cc01-Admin-Key)",
    "",
    "Ichki listener mTLS (A-S5). Internal:Tls:CertPath berilsa yoqiladi va",
    "to'rttasi ham majburiy; berilmasa — h2c, lekin FAQAT loopback",
    "Internal:Address'da (aks holda server ishga tushmaydi):",
    "  Internal__Tls__CertPath=/etc/cc01/ap.crt        (PEM, server sertifikati)",
    "  Internal__Tls__KeyPath=/etc/cc01/ap.key         (PEM, ECDSA P-256 yoki RSA)",
    "  Internal__Tls__ClientCaPath=/etc/cc01/edge-ca.pem  (klient CA'lari — yagona ishonch)",
    "  Internal__Tls__AllowedClients=edge-1,edge-2     (CN allowlist; massiv ham bo'ladi)"
  ],

  "Jwt": {
    "Issuer": "cc01-access",
    "Audience": "cc01-dashboard",
    "LifetimeMinutes": 60
  }
}
