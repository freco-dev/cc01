<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../AccessServer.Application/AccessServer.Application.csproj" />
    <ProjectReference Include="../AccessServer.Infrastructure/AccessServer.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Yagona kontrakt manbai: proto/ papkasi. C# kodi build vaqtida
       generatsiya qilinadi (Grpc.Tools), Go tomonda esa `make proto`. -->
  <ItemGroup>
    <Protobuf Include="../../../proto/cc01/v1/access.proto"
              ProtoRoot="../../../proto"
              GrpcServices="Server" />
    <Protobuf Include="../../../proto/cc01/v1/tunnel.proto"
              ProtoRoot="../../../proto"
              GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>
</Project>
