<!-- Barcha AccessServer loyihalari uchun umumiy sozlamalar.
     Har bir .csproj'da takrorlanmasligi uchun shu yerda. -->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- DEV_SPEC §7.4: warning'lar xato sifatida. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Paket versiyalari Directory.Packages.props da, bitta joyda. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Reproducible build (§7.2 S-8 ruhida). -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
