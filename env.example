# CC01 core server environment example
# Copy this file to your real env file and fill in the values for your deployment.

# Base domain used to build public tunnel hostnames.
# Example: if this is "example.com", tunnels become "subdomain.example.com".
CC01_DOMAIN=example.com

# Path to the TLS certificate file used by the public HTTPS listener.
CC01_TLS_CERT=/etc/ssl/certs/cc01.crt

# Path to the TLS private key file used by the public HTTPS listener.
CC01_TLS_KEY=/etc/ssl/private/cc01.key
