# cc01d konfiguratsiyasi.
#
# Bu fayl paket yangilanganda SAQLANADI (nfpm config file).

# Control Plane manzili. Bo'sh qoldirilsa demon statik rejimda
# ishlaydi va peerlarni bayroqlardan kutadi.
CC01_CP_ADDR=

# CP bilan kelishilgan sir.
CC01_CP_TOKEN=

# CP sertifikatining SPKI pini ("sha256/..."). CP ishga tushganda uni
# chiqaradi. Bo'sh qoldirilsa sertifikat tizim ildizlari bilan
# tekshiriladi — self-signed CP uchun bu ishlamaydi.
#
# Kalit almashtirilayotganda eski va yangi pinni vergul bilan birga
# berish mumkin.
CC01_CP_PIN=

# Node kaliti (base64). Bo'sh bo'lsa demon ishga tushmaydi —
# yangisini yaratish: cc01d -genkey
CC01_PRIVATE_KEY=

# NAT ortida public manzilni aniqlash uchun STUN serveri (host:port).
CC01_STUN=

# Node sertifikati saqlanadigan papka.
#
# Bo'sh qoldirilsa systemd bergan StateDirectory ishlatiladi
# (/var/lib/cc01). Sertifikat birinchi ishga tushishda yaratiladi va
# keyin O'ZGARMAYDI — u nodening CP oldidagi dalili. Papkani
# o'chirish nodeni qaytadan ro'yxatdan o'tkazishga majbur qiladi va
# buning uchun token kerak bo'ladi.
