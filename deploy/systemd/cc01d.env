# cc01d konfiguratsiyasi.
#
# Bu fayl paket yangilanganda SAQLANADI (nfpm config file).

# Control Plane manzili. Bo'sh qoldirilsa demon statik rejimda
# ishlaydi va peerlarni bayroqlardan kutadi.
CC01_CP_ADDR=

# CP bilan kelishilgan sir.
CC01_CP_TOKEN=

# Node kaliti (base64). Bo'sh bo'lsa demon ishga tushmaydi —
# yangisini yaratish: cc01d -genkey
CC01_PRIVATE_KEY=

# NAT ortida public manzilni aniqlash uchun STUN serveri (host:port).
CC01_STUN=
